#!/usr/bin/env bash
# flowsegul — one-word interactive call-flow explorer.
#   flowsegul            # visualize every FastAPI route across your Python repos
#   flowsegul --changed  # only what changed on the current branch(es) vs main
#   flowsegul --entries foo bar        # specific functions
#   flowsegul serve      # same, but served locally so the page can switch branches / commits itself
# Any flowsegul_gen.py flag is passed through (--base, --depth, --repo, --workspace, --title, --out).
set -euo pipefail
# resolve through symlinks (this script is symlinked onto PATH) to find flowsegul_gen.py next to it
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [ "${src#/}" = "$src" ] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"

# `flowsegul serve [flags]`: local server; the page itself can switch branch / commit / range
if [ "${1:-}" = "serve" ]; then
  shift
  exec python3 "$here/flowsegul_gen.py" --serve "$@"
fi
# a fresh file per run (GNU mktemp needs the XXXXXX; BSD/macOS accepts it too)
out="${FLOWSEGUL_OUT:-$(mktemp -d "${TMPDIR:-/tmp}/flowsegul.XXXXXX")/flowsegul.html}"

# only inject a default --out if the user didn't pass one; --help writes nothing
case " $* " in *" --out "*|*" --out="*) out="";; esac
case " $* " in *" -h "*|*" --help "*) exec python3 "$here/flowsegul_gen.py" "$@";; esac

python3 "$here/flowsegul_gen.py" ${out:+--out "$out"} "$@"

# figure out the path we wrote (respect an explicit --out)
path="$out"
if [ -z "$path" ]; then
  for ((i=1;i<=$#;i++)); do
    case "${!i}" in --out) j=$((i+1)); path="${!j}";; --out=*) path="${!i#--out=}";; esac
  done
fi
if [ -n "$path" ]; then
  echo "flowsegul → $path"
  # macOS `open`; on Linux `open` is often openvt (a console tool), so use xdg-open there
  if [ "$(uname)" = "Darwin" ]; then open "$path" || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$path" >/dev/null 2>&1 || true
  elif command -v wslview >/dev/null 2>&1; then wslview "$path" || true
  fi
fi
